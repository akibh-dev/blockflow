{
  "name": "blockflow",
  "description": "Playwright-compatible automation in your browser: build automations from connected blocks, or write them as scripts.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:safari": "wxt build -b safari",
    "build:all": "npm run build && npm run build:firefox && npm run build:safari",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run test && npm run learn:check && npm run guide:check && npm run wiki:check",
    "learn:sync": "node docs/learning/tools/sync-examples.mjs",
    "learn:check": "node docs/learning/tools/sync-examples.mjs --check",
    "postinstall": "wxt prepare",
    "e2e": "BF_E2E=1 wxt build && node tests/e2e/run.mjs",
    "e2e:run": "node tests/e2e/run.mjs",
    "e2e:firefox": "BF_E2E=1 wxt build -b firefox && node tests/e2e/firefox.mjs",
    "playground": "node scripts/playground.mjs",
    "guide:sync": "vite-node scripts/guide.ts",
    "guide:check": "vite-node scripts/guide.ts -- --check",
    "wiki:check": "node scripts/wiki.mjs --check",
    "wiki:publish": "node scripts/wiki.mjs --push"
  },
  "dependencies": {
    "@xyflow/react": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitest/coverage-v8": "3.2.7",
    "@wxt-dev/module-react": "^1.1.0",
    "jsdom": "^26.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0",
    "wxt": "^0.20.0"
  }
}
