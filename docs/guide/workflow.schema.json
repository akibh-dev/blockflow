{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/akib35/blockflow/docs/guide/workflow.schema.json",
  "title": "BlockFlow workflow export file",
  "description": "What Import accepts: {format, version, workflows[]} or a single workflow object. Generated by scripts/guide.ts.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "workflows"
      ],
      "properties": {
        "format": {
          "const": "blockflow-workflows"
        },
        "version": {
          "const": 1
        },
        "workflows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/workflow"
          }
        }
      }
    },
    {
      "$ref": "#/$defs/workflow"
    }
  ],
  "$defs": {
    "workflow": {
      "type": "object",
      "required": [
        "name",
        "nodes",
        "edges"
      ],
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "description": "Replaced on import."
        },
        "name": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean",
          "description": "Ignored on import: imported workflows are always off."
        },
        "nodes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "timer"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Start the flow on a schedule, or delay it when placed after another block.",
                    "properties": {
                      "seconds": {
                        "description": "Under 30 seconds the extension keeps its background worker awake to fire on time (Chromium). 30 seconds or more uses browser alarms.",
                        "type": "number",
                        "minimum": 1
                      },
                      "repeat": {
                        "description": "Only used when this block starts the flow. After another block it always fires once.",
                        "type": "boolean"
                      }
                    },
                    "required": []
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "watch-element"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Fire when the text of a part of a web page changes.",
                    "properties": {
                      "selector": {
                        "description": "Element",
                        "type": "string"
                      },
                      "url": {
                        "description": "Page URL",
                        "type": "string"
                      },
                      "intervalSeconds": {
                        "description": "Only used when this block starts the flow. After a Timer, the Timer decides. Under 30 seconds keeps the background worker awake.",
                        "type": "number",
                        "minimum": 1
                      },
                      "reload": {
                        "description": "Needed to see server-side changes. Turn off for pages that update themselves.",
                        "type": "boolean"
                      },
                      "emitOnFirstRead": {
                        "description": "Off = the first read just records the starting value.",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "selector",
                      "url"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "open-url"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Open a web page, and remember the tab for the next blocks.",
                    "properties": {
                      "url": {
                        "description": "Use {{name}} to insert a value from the previous block.",
                        "type": "string"
                      },
                      "where": {
                        "description": "Open in",
                        "enum": [
                          "new",
                          "workflow",
                          "window",
                          "current"
                        ]
                      },
                      "tab": {
                        "description": "Later blocks find the tab by this name. Use another name (e.g. \"admin\") for a second tab.",
                        "type": "string"
                      },
                      "active": {
                        "description": "Off = open quietly in the background.",
                        "type": "boolean"
                      },
                      "waitUntil": {
                        "description": "Continue when",
                        "enum": [
                          "load",
                          "networkidle",
                          "none"
                        ]
                      }
                    },
                    "required": [
                      "url"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "click"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Click (or double-click, right-click, hover) an element. Waits until it can be clicked.",
                    "properties": {
                      "locator": {
                        "description": "CSS, or text=…, role=…[name=\"…\"], label=…, placeholder=…, testid=…, A >> B, >> nth=0. Or press 🎯 Pick.",
                        "type": "string"
                      },
                      "action": {
                        "description": "Action",
                        "enum": [
                          "click",
                          "double",
                          "right",
                          "hover"
                        ]
                      },
                      "force": {
                        "description": "Click even if the element looks hidden, disabled or covered. Only for stubborn pages.",
                        "type": "boolean"
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": [
                      "locator"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "fill"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Type a value into a text field. Works with React, Vue and Angular forms.",
                    "properties": {
                      "locator": {
                        "description": "CSS, or text=…, role=…[name=\"…\"], label=…, placeholder=…, testid=…, A >> B, >> nth=0. Or press 🎯 Pick.",
                        "type": "string"
                      },
                      "value": {
                        "description": "Value",
                        "type": "string"
                      },
                      "mode": {
                        "description": "How",
                        "enum": [
                          "fill",
                          "type"
                        ]
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": [
                      "locator"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "fill-form"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Fill several fields at once: text, selects, checkboxes. Optionally click submit.",
                    "properties": {
                      "fields": {
                        "description": "Empty values are skipped. Selects take the option text or value; checkboxes take true or false.",
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "locator": {
                              "type": "string",
                              "description": "Field"
                            },
                            "value": {
                              "type": "string",
                              "description": "Value"
                            }
                          }
                        }
                      },
                      "submit": {
                        "description": "CSS, or text=…, role=…[name=\"…\"], label=…, placeholder=…, testid=…, A >> B, >> nth=0. Or press 🎯 Pick.",
                        "type": "string"
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": [
                      "fields"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "select-option"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Choose an option in a dropdown (<select>), by its text or value.",
                    "properties": {
                      "locator": {
                        "description": "CSS, or text=…, role=…[name=\"…\"], label=…, placeholder=…, testid=…, A >> B, >> nth=0. Or press 🎯 Pick.",
                        "type": "string"
                      },
                      "value": {
                        "description": "Several for a multi-select: separate with |",
                        "type": "string"
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": [
                      "locator",
                      "value"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "check"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Tick or untick a checkbox, radio button or switch. Does nothing if it already is.",
                    "properties": {
                      "locator": {
                        "description": "CSS, or text=…, role=…[name=\"…\"], label=…, placeholder=…, testid=…, A >> B, >> nth=0. Or press 🎯 Pick.",
                        "type": "string"
                      },
                      "state": {
                        "description": "Make it",
                        "enum": [
                          "check",
                          "uncheck"
                        ]
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": [
                      "locator"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "press-key"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Press a key or shortcut: Enter, Tab, Escape, Control+A…",
                    "properties": {
                      "key": {
                        "description": "Key names as on the keyboard: Enter, Tab, Escape, Backspace, ArrowDown, a, Control+A, Shift+Tab.",
                        "type": "string"
                      },
                      "locator": {
                        "description": "Focus this element first. Empty = whatever has focus.",
                        "type": "string"
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": [
                      "key"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "wait-for"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Wait until an element appears or goes, some text shows, the URL changes, or the page settles.",
                    "properties": {
                      "mode": {
                        "description": "Wait until",
                        "enum": [
                          "visible",
                          "hidden",
                          "attached",
                          "detached",
                          "enabled",
                          "text",
                          "no-text",
                          "url",
                          "load",
                          "networkidle"
                        ]
                      },
                      "locator": {
                        "description": "For the element modes. For text: only look inside this element (optional).",
                        "type": "string"
                      },
                      "text": {
                        "description": "Text",
                        "type": "string"
                      },
                      "url": {
                        "description": "Plain text: the URL contains it. * matches any part between slashes, ** anything. /…/ is a regular expression.",
                        "type": "string"
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": []
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "read-element"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Read a value from a page: text, attribute, class, whether it exists, or how many.",
                    "properties": {
                      "selector": {
                        "description": "Element",
                        "type": "string"
                      },
                      "url": {
                        "description": "BlockFlow opens it in its own background tab. Leave empty to read the run's tab instead (see Tab).",
                        "type": "string"
                      },
                      "tab": {
                        "description": "Used when Page URL is empty: read from this tab of the run (from Open Tab), as it is now, without reloading.",
                        "type": "string"
                      },
                      "read": {
                        "description": "Read",
                        "enum": [
                          "text",
                          "value",
                          "attribute",
                          "has-class",
                          "exists",
                          "count"
                        ]
                      },
                      "name": {
                        "description": "Only for \"an attribute\" and \"has a class\".",
                        "type": "string"
                      },
                      "reload": {
                        "description": "Reload page before reading",
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "selector"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "assert"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Check that something is true. Fails the run (or just records it, if soft) when it is not.",
                    "properties": {
                      "subject": {
                        "description": "Check",
                        "enum": [
                          "text",
                          "input",
                          "attribute",
                          "count",
                          "visible",
                          "hidden",
                          "checked",
                          "unchecked",
                          "enabled",
                          "disabled",
                          "url",
                          "title",
                          "value"
                        ]
                      },
                      "locator": {
                        "description": "For element checks.",
                        "type": "string"
                      },
                      "name": {
                        "description": "Only for \"attribute of an element\".",
                        "type": "string"
                      },
                      "value": {
                        "description": "Only for \"a value from the data\".",
                        "type": "string"
                      },
                      "operator": {
                        "description": "Not used by the yes/no checks (visible, checked…).",
                        "enum": [
                          "equals",
                          "not-equals",
                          "contains",
                          "not-contains",
                          "starts-with",
                          "ends-with",
                          "matches",
                          "greater",
                          "greater-equal",
                          "less",
                          "less-equal",
                          "empty",
                          "not-empty",
                          "true",
                          "false"
                        ]
                      },
                      "expected": {
                        "description": "Expected",
                        "type": "string"
                      },
                      "message": {
                        "description": "Message when it fails",
                        "type": "string"
                      },
                      "soft": {
                        "description": "Soft: record the failure but keep going",
                        "type": "boolean"
                      },
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": []
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "navigate"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Go to a URL, back, forward, or reload, in a tab of this run.",
                    "properties": {
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      },
                      "action": {
                        "description": "Action",
                        "enum": [
                          "goto",
                          "back",
                          "forward",
                          "reload"
                        ]
                      },
                      "url": {
                        "description": "URL",
                        "type": "string"
                      },
                      "waitUntil": {
                        "description": "Continue when",
                        "enum": [
                          "load",
                          "networkidle",
                          "none"
                        ]
                      }
                    },
                    "required": []
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "close-tab"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Close a tab this run opened.",
                    "properties": {
                      "tab": {
                        "description": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\".",
                        "type": "string"
                      }
                    },
                    "required": []
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "if"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Go one way when a condition is true, another when it is false.",
                    "properties": {
                      "left": {
                        "description": "Value",
                        "type": "string"
                      },
                      "operator": {
                        "description": "Condition",
                        "enum": [
                          "equals",
                          "not-equals",
                          "contains",
                          "not-contains",
                          "starts-with",
                          "ends-with",
                          "matches",
                          "greater",
                          "greater-equal",
                          "less",
                          "less-equal",
                          "empty",
                          "not-empty",
                          "true",
                          "false"
                        ]
                      },
                      "right": {
                        "description": "Ignored by \"is empty\", \"is true\" and similar. For a pattern, write /text/i.",
                        "type": "string"
                      }
                    },
                    "required": []
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "type": {
                    "const": "set-variable"
                  },
                  "position": {
                    "type": "object",
                    "properties": {
                      "x": {
                        "type": "number"
                      },
                      "y": {
                        "type": "number"
                      }
                    }
                  },
                  "config": {
                    "type": "object",
                    "description": "Add a value to the data flowing through.",
                    "properties": {
                      "name": {
                        "description": "Name",
                        "type": "string"
                      },
                      "value": {
                        "description": "Value",
                        "type": "string"
                      }
                    },
                    "required": [
                      "name"
                    ]
                  },
                  "step": {
                    "$ref": "#/$defs/step"
                  }
                }
              },
              {
                "type": "object",
                "required": [
                  "id",
                  "type",
                  "position",
                  "config"
                ],
                "properties": {
                  "id": {
