        },
        {
          "key": "maxPages",
          "label": "At most (pages)",
          "kind": "number",
          "min": 1
        },
        {
          "key": "tab",
          "label": "Tab",
          "kind": "text",
          "help": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\"."
        }
      ],
      "outputs": [
        {
          "key": "page",
