    {
      "type": "assert",
      "label": "Assert",
      "category": "test",
      "description": "Check that something is true. Fails the run (or just records it, if soft) when it is not.",
      "canStart": true,
      "canTakeInput": true,
      "ports": [
        "out"
      ],
      "timeoutSeconds": 10,
      "defaultConfig": {
        "subject": "text",
        "value": "",
        "locator": "",
        "name": "",
        "operator": "contains",
        "expected": "",
        "message": "",
        "soft": false,
        "tab": "main"
      },
      "fields": [
        {
          "key": "subject",
          "label": "Check",
          "kind": "select",
          "options": [
            "text",
            "input",
            "attribute",
            "count",
            "visible",
            "hidden",
            "checked",
            "unchecked",
            "enabled",
            "disabled",
            "url",
            "title",
            "value"
          ]
        },
        {
          "key": "locator",
          "label": "Element",
          "kind": "locator",
          "templated": true,
          "help": "For element checks."
        },
        {
          "key": "name",
          "label": "Attribute name",
          "kind": "text",
          "help": "Only for \"attribute of an element\"."
        },
        {
          "key": "value",
          "label": "Value",
          "kind": "text",
          "templated": true,
          "help": "Only for \"a value from the data\"."
        },
        {
          "key": "operator",
          "label": "Must",
          "kind": "select",
          "options": [
            "equals",
            "not-equals",
            "contains",
            "not-contains",
            "starts-with",
            "ends-with",
            "matches",
            "greater",
            "greater-equal",
            "less",
            "less-equal",
            "empty",
            "not-empty",
            "true",
            "false"
          ],
          "help": "Not used by the yes/no checks (visible, checked…)."
        },
        {
          "key": "expected",
          "label": "Expected",
          "kind": "text",
          "templated": true
        },
        {
          "key": "message",
          "label": "Message when it fails",
          "kind": "text",
          "templated": true
        },
        {
          "key": "soft",
          "label": "Soft: record the failure but keep going",
          "kind": "boolean"
        },
        {
          "key": "tab",
          "label": "Tab",
          "kind": "text",
          "help": "The name an Open Tab block gave the tab earlier in this run. Usually \"main\"."
        }
      ],
      "outputs": [
        {
          "key": "actual",
          "description": "What was found."
        }
      ]
    },
    {
      "type": "manual-step",
