          "label": "Value",
          "kind": "text",
          "templated": true
        },
        {
          "key": "operator",
          "label": "Condition",
          "kind": "select",
          "options": [
            "equals",
            "not-equals",
            "contains",
            "not-contains",
            "starts-with",
            "ends-with",
            "matches",
            "greater",
