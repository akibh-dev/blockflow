{
  "format": "blockflow-workflows",
  "version": 1,
  "workflows": [
    {
      "schemaVersion": 2,
      "id": "ddt",
      "name": "Data-driven login test",
      "enabled": false,
      "nodes": [
        {
          "id": "data",
          "type": "data-table",
          "position": {
            "x": 0,
            "y": 0
          },
          "config": {
            "text": "email,password,expect\nadmin@example.com,USE_SECRET,Dashboard\nnobody@example.com,wrong,Wrong email or password",
            "into": "rows"
          }
        },
        {
          "id": "each",
          "type": "for-each",
          "position": {
            "x": 260,
            "y": 0
          },
          "config": {
            "list": "rows",
            "as": "row"
          }
        },
        {
          "id": "open",
          "type": "open-url",
          "position": {
            "x": 520,
            "y": -140
          },
          "config": {
            "url": "https://example.com/login",
            "where": "window"
          }
        },
        {
          "id": "form",
          "type": "fill-form",
          "position": {
            "x": 780,
            "y": -140
          },
          "config": {
            "fields": [
              {
                "locator": "label=Email",
                "value": "{{row.email}}"
              },
              {
                "locator": "label=Password",
                "value": "{{ row.password == 'USE_SECRET' ? secret.adminPassword : row.password }}"
              }
            ],
            "submit": "role=button[name=\"Sign in\"]"
          }
        },
        {
          "id": "see",
          "type": "assert",
          "position": {
            "x": 1040,
            "y": -140
          },
          "config": {
            "subject": "text",
            "locator": "body",
            "operator": "contains",
            "expected": "{{row.expect}}",
            "soft": true
          }
        },
        {
          "id": "close",
          "type": "close-tab",
          "position": {
            "x": 1300,
            "y": -140
          },
          "config": {}
        }
      ],
      "edges": [
        {
          "id": "e0",
          "source": "data",
          "target": "each"
        },
        {
          "id": "e1",
          "source": "each",
          "target": "open",
          "sourcePort": "each"
        },
        {
          "id": "e2",
          "source": "open",
          "target": "form"
        },
        {
          "id": "e3",
          "source": "form",
          "target": "see"
        },
        {
          "id": "e4",
          "source": "see",
          "target": "close"
        }
      ]
    }
  ]
}