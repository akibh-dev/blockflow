{
  "name": "blockflow-mcp",
  "version": "1.0.0",
  "description": "MCP server (stdio) for the BlockFlow browser extension: validate, run and repair workflows in your real browser.",
  "keywords": [
    "blockflow",
    "mcp",
    "model-context-protocol",
    "browser-automation",
    "testing",
    "claude"
  ],
  "homepage": "https://github.com/akibh-dev/blockflow#readme",
  "bugs": {
    "url": "https://github.com/akibh-dev/blockflow/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akibh-dev/blockflow.git",
    "directory": "packages/mcp"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "blockflow-mcp": "./server.mjs"
  },
  "main": "./index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "*.d.mts",
    "*.mjs",
    "LICENSE",
    "README.md",
    "resources/",
    "scripts/"
  ],
  "scripts": {
    "prepack": "node scripts/pack.mjs copy",
    "postpack": "node scripts/pack.mjs clean"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "blockflow-bridge": "1.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  }
}
