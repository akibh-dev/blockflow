{
  "name": "blockflow-mcp",
  "version": "0.5.0",
  "description": "MCP server (stdio) for the BlockFlow browser extension: validate, run and repair workflows in your real browser.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "blockflow-mcp": "./server.mjs"
  },
  "main": "./index.mjs",
  "exports": {
    ".": {
      "types": "./index.d.mts",
      "default": "./index.mjs"
    }
  },
  "files": [
    "*.mjs",
    "*.d.mts",
    "scripts/",
    "resources/"
  ],
  "scripts": {
    "prepack": "node scripts/pack.mjs copy",
    "postpack": "node scripts/pack.mjs clean"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "blockflow-bridge": "0.5.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  }
}
