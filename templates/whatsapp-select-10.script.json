{
  "format": "blockflow-script",
  "version": 1,
  "name": "WhatsApp - select 10 messages (19 CSE Akib)",
  "steps": [
    {
      "id": "open",
      "open": {
        "url": "https://web.whatsapp.com/",
        "where": "new",
        "active": true,
        "waitUntil": "load"
      }
    },
    {
      "id": "waitChatList",
      "wait-for": {
        "mode": "visible",
        "locator": "span[title=\"19 CSE Akib\"] >> nth=0"
      },
      "step": {
        "timeoutSeconds": 90
      }
    },
    {
      "id": "openChat",
      "click": {
        "locator": "span[title=\"19 CSE Akib\"] >> nth=0"
      },
      "step": {
        "retries": 2
      }
    },
    {
      "id": "waitMessages",
      "wait-for": {
        "mode": "visible",
        "locator": "#main div[role=\"row\"] >> has=div[data-id] >> nth=-1"
      },
      "step": {
        "timeoutSeconds": 30
      }
    },
    {
      "id": "openMenu",
      "click": {
        "locator": "#main header >> role=button[name=\"Menu\"]"
      },
      "step": {
        "retries": 2
      }
    },
    {
      "id": "selectMode",
      "click": {
        "locator": "text=/select messages/i >> nth=0"
      },
      "step": {
        "retries": 2
      }
    },
    {
      "id": "pause",
      "timer": {
        "seconds": 1,
        "repeat": false
      }
    },
    {
      "id": "countRows",
      "read-element": {
        "locator": "#main div[role=\"row\"] >> has=div[data-id]",
        "read": "count",
        "tab": "main"
      }
    },
    {
      "id": "logCount",
      "log": {
        "message": "Message rows found: {{count}}",
        "level": "info"
      }
    },
    {
      "id": "countBoxes",
      "read-element": {
        "locator": "#main >> role=checkbox[include-hidden]",
        "read": "count",
        "tab": "main"
      }
    },
    {
      "id": "logBoxes",
      "log": {
        "message": "Checkboxes found: {{count}}",
        "level": "info"
      }
    },
    {
      "id": "m1",
      "click": {
        "locator": "#main div[role=\"row\"] >> has=div[data-id] >> nth=-1 >> role=checkbox[include-hidden] >> nth=0",
        "force": true
      },
      "step": {
        "retries": 1
      }
    },
    {
      "id": "pm1",
      "timer": {
        "seconds": 1,
        "repeat": false
      }
    },
    {
      "id": "m2",
